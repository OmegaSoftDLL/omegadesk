;
; quickdesk_display.inf
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class = Display
ClassVer = 2.0
Provider=%ManufacturerName%
CatalogFile=quickdesk_display.cat
DriverVer = 04/23/2026,16.46.38.311

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName%=MyDevice_Install, Root\QuickDesk\VDD ; TODO: edit hw-id, this hardware id is used by Visual Studio remote debugging
%DeviceName%=MyDevice_Install, Root\QuickDesk\VDD ; TODO: edit hw-id, this hardware id is used by the IddSampleApp.exe

[SourceDisksFiles]
quickdesk_display.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[MyDevice_Install.NT]
CopyFiles=UMDriverCopy

[MyDevice_Install.NT.hw]
AddReg = MyDevice_HardwareDeviceSettings

[MyDevice_HardwareDeviceSettings]
HKR,, "UpperFilters",  %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "QuickDeskVDDGroup" ; TODO: edit driver group name, see README.md for more info
HKR,,Security,,"D:P(A;;GA;;;BA)(A;;GA;;;SY)(A;;GA;;;UD)(A;;GRGW;;;BU)"

[MyDevice_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[MyDevice_Install.NT.Wdf]
UmdfService=quickdesk_display,quickdesk_display_Install
UmdfServiceOrder=quickdesk_display
UmdfKernelModeClientPolicy = AllowKernelModeClients

[quickdesk_display_Install]
UmdfLibraryVersion=2.25.0 
ServiceBinary=%12%\UMDF\quickdesk_display.dll
UmdfExtensions = IddCx0102

[WUDFRD_ServiceInstall]
DisplayName = %WudfRdDisplayName%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\WUDFRd.sys

[DestinationDirs]
UMDriverCopy=12,UMDF ; copy to drivers\umdf

[UMDriverCopy]
quickdesk_display.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="QuickCoder" ;
DiskName = "QuickDesk Virtual Display Driver" ;
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"
DeviceName="QuickDesk Virtual Display" ;

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000
REG_EXPAND_SZ = 0x00020000
REG_DWORD     = 0x00010001


; OmegaDesk IddCx 1.4 Indirect Display Driver (UMDF 2) INF specification
; Reference: ClassicOldSong_Apollo/src/platform/windows/virtual_display.cpp
[Version]
Signature   = "$Windows NT$"
Class       = Display
ClassGuid   = {4d36e968-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = omegadesk-idd.cat
DriverVer   = 11/01/2026,0.1.0.0
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64

[Standard.NTamd64]
%DeviceName% = OmegaDeskIdd_Install, Root\OmegaDeskIdd

[Strings]
ManufacturerName = "OmegaSoft DLL"
DeviceName       = "OmegaDesk Virtual Display Adapter (IddCx)"
